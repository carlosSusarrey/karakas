// Karakas - MTG Game Tracker
// Prisma Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String?  // Null if using OAuth only
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  oauthAccounts        OAuthAccount[]
  decks                Deck[]          // Decks created by this user
  gamePlayers          GamePlayer[]
  powerPlays           PowerPlay[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]

  // Playgroup relations
  playgroupsOwned      Playgroup[]        @relation("PlaygroupOwner")
  playgroupMemberships PlaygroupMember[]
  playgroupInvitesSent PlaygroupMember[]  @relation("InvitedBy")
  linkedPlaygroupPlayer PlaygroupPlayer?  @relation("LinkedUser")

  // Games created by this user
  gamesCreated Game[] @relation("GameCreator")
}

model OAuthAccount {
  id           String @id @default(cuid())
  userId       String
  provider     String // "google", "discord", "github"
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PLAYGROUPS
// ============================================

model Playgroup {
  id            String   @id @default(cuid())
  name          String
  description   String?
  defaultFormat String?  // Default MTG format for new games
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  owner    User              @relation("PlaygroupOwner", fields: [ownerId], references: [id])
  members  PlaygroupMember[]
  players  PlaygroupPlayer[] // Non-registered players
  decks    Deck[]
  games    Game[]
}

model PlaygroupMember {
  id          String   @id @default(cuid())
  playgroupId String
  userId      String
  role        String   @default("member") // "owner", "admin", "member"
  joinedAt    DateTime @default(now())
  invitedById String?

  // Relations
  playgroup Playgroup @relation(fields: [playgroupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([playgroupId, userId])
}

model PlaygroupPlayer {
  id           String   @id @default(cuid())
  playgroupId  String
  name         String
  email        String?  // Optional, for sending claim invitations
  linkedUserId String?  @unique // When claimed by a registered user
  createdAt    DateTime @default(now())

  // Relations
  playgroup   Playgroup                    @relation(fields: [playgroupId], references: [id], onDelete: Cascade)
  linkedUser  User?                        @relation("LinkedUser", fields: [linkedUserId], references: [id])
  gamePlayers GamePlayer[]
  decks       PlaygroupPlayerDeck[]        // Decks associated with this player
  claimTokens PlaygroupPlayerClaimToken[]  // Tokens for claiming this player
}

model PlaygroupPlayerDeck {
  id                 String   @id @default(cuid())
  playgroupPlayerId  String
  name               String
  format             String   // "commander", "standard", etc.

  // Commander-specific fields
  commander1   String?  // Primary commander card name
  commander2   String?  // Partner commander (if applicable)
  bracket      Int?     // EDH bracket (1-4)

  // Optional decklist
  decklistUrl  String?  // Link to Moxfield, Archidekt, etc.

  // Linking to user deck after claim
  linkedDeckId String?  @unique // When linked to a user's Deck after claim

  isActive     Boolean  @default(true) // Soft delete / archive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  playgroupPlayer PlaygroupPlayer @relation(fields: [playgroupPlayerId], references: [id], onDelete: Cascade)
  linkedDeck      Deck?           @relation(fields: [linkedDeckId], references: [id], onDelete: SetNull)
  gamePlayers     GamePlayer[]
}

model PlaygroupInvitation {
  id          String   @id @default(cuid())
  playgroupId String
  email       String
  token       String   @unique
  role        String   @default("member") // Role to assign when accepted
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([playgroupId, email])
}

model PlaygroupPlayerClaimToken {
  id                  String   @id @default(cuid())
  playgroupPlayerId   String
  email               String
  token               String   @unique
  invitedById         String
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  // Relations
  playgroupPlayer PlaygroupPlayer @relation(fields: [playgroupPlayerId], references: [id], onDelete: Cascade)

  @@unique([playgroupPlayerId, email])
}

// ============================================
// DECKS
// ============================================

model Deck {
  id           String   @id @default(cuid())
  userId       String   // User who created the deck
  playgroupId  String?  // Optional playgroup association
  name         String
  format       String   // "commander", "standard", "modern", "legacy", "vintage", "pioneer", "pauper", "draft", "sealed"

  // Commander-specific fields
  commander1   String?  // Primary commander card name
  commander2   String?  // Partner commander (if applicable)
  bracket      Int?     // EDH bracket (1-4)

  // Optional decklist
  decklistUrl  String?  // Link to Moxfield, Archidekt, etc.

  isActive     Boolean  @default(true) // Soft delete / archive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  playgroup               Playgroup?            @relation(fields: [playgroupId], references: [id], onDelete: SetNull)
  gamePlayers             GamePlayer[]
  linkedPlaygroupPlayerDeck PlaygroupPlayerDeck?  @relation // Reverse relation for linked deck
}

// ============================================
// GAMES
// ============================================

model Game {
  id          String   @id @default(cuid())
  createdById String
  playgroupId String?  // Optional playgroup association
  format      String   // Game format
  totalTurns  Int?     // Total turns in the game
  notes       String?  // Optional game notes
  playedAt    DateTime @default(now()) // When the game was played
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy   User         @relation("GameCreator", fields: [createdById], references: [id])
  playgroup   Playgroup?   @relation(fields: [playgroupId], references: [id], onDelete: SetNull)
  players     GamePlayer[]
  powerPlays  PowerPlay[]
}

model GamePlayer {
  id                      String  @id @default(cuid())
  gameId                  String
  userId                  String?  // Null if player is not a registered user
  playgroupPlayerId       String?  // For non-registered playgroup players
  deckId                  String?  // For registered user decks
  playgroupPlayerDeckId   String?  // For playgroup player decks (non-registered)

  // Player identification for non-users (legacy/ad-hoc)
  guestName String?  // Name for guest players without playgroup player record

  // Game-specific deck info (snapshot at time of game)
  commanderUsed1 String? // Commander used in this game
  commanderUsed2 String? // Partner commander used
  bracketUsed    Int?    // Bracket for this game

  // Results
  placement      Int?    // 1 = winner, 2 = second, etc.
  isWinner       Boolean @default(false)
  isFirstOut     Boolean @default(false) // First eliminated
  eliminatedTurn Int?    // Turn when eliminated (null if won or game ended)

  // Relations
  game                 Game                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id])
  playgroupPlayer      PlaygroupPlayer?     @relation(fields: [playgroupPlayerId], references: [id])
  deck                 Deck?                @relation(fields: [deckId], references: [id])
  playgroupPlayerDeck  PlaygroupPlayerDeck? @relation(fields: [playgroupPlayerDeckId], references: [id])
  powerPlays           PowerPlay[]

  @@unique([gameId, userId])
}

// ============================================
// POWER PLAYS
// ============================================

model PowerPlay {
  id           String  @id @default(cuid())
  gameId       String
  gamePlayerId String
  userId       String? // The user who made the play

  turn         Int     // Turn number when the play happened
  type         String  // Type of power play (e.g., "combo", "boardwipe", "theft", "wincon", "removal", "counter", "ramp", "other")
  description  String  // Description of what happened
  cardName     String? // Primary card involved (optional)

  createdAt    DateTime @default(now())

  // Relations
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
}
